FLASK_ENV=production
PORT=10000

# --- Conexión a la RDS de sico (esquema sco) ---
# Se conecta directo con las credenciales existentes (como DBeaver); no hay un
# usuario de solo-lectura dedicado. La protección contra escrituras es a nivel
# de sesión: cada conexión se pone en READ ONLY automáticamente.
SICO_DB_HOST=mappale-sico.cdngbntx2q8s.us-west-2.rds.amazonaws.com
SICO_DB_PORT=3306
SICO_DB_USER=
SICO_DB_PASSWORD=
# Poner en 'require' si se decide forzar TLS hacia la RDS.
SICO_DB_SSL=

# El usuario configurado tiene privilegios de escritura (cuenta compartida).
# Este flag confirma de forma explícita que se acepta conectar con una cuenta
# privilegiada. Sin él, el backend se niega a arrancar si detecta un usuario
# con permisos de escritura (protección contra usarlo por accidente).
SICO_ALLOW_WRITE_USER=true

# Tiempo máximo por celda (segundos) antes de cortar la ejecución.
CELL_TIMEOUT_SECONDS=15

# --- Asistente en lenguaje natural (Epic 6) ---
# Secreto de API del proveedor LLM (Gemini - swap post-Epic-8, provider
# gratis, mismo contrato cerrado NFR10/NFR11 de antes). Nunca se expone al
# frontend. Sin esta variable, el endpoint
# /api/notebook/interpret-chart-request responde con un mensaje claro de
# "asistente no disponible" en vez de fallar. Consíguela en
# https://aistudio.google.com/apikey.
GEMINI_API_KEY=

# Máximo de preguntas al asistente por sesión (NFR11, control de costo en un
# servicio público sin login). No se resetea con "Reiniciar sesión" - solo
# expira por inactividad de la sesión (mismo TTL que el resto del estado por
# sesión, 30 minutos por defecto).
ASSISTANT_MAX_REQUESTS_PER_SESSION=20

# Tope global (todas las sesiones juntas) de preguntas al asistente por día
# calendario. Con sesiones emitidas por el servidor, abrir sesiones nuevas ya
# no da presupuesto infinito: este tope no se reinicia hasta el día siguiente.
ASSISTANT_MAX_REQUESTS_PER_DAY=200

# --- Seguridad (auditoría 2026-11-18) ---
# Clave compartida del equipo. Si se define, todo /api/* (salvo /api/health)
# exige el header X-Access-Key con este valor; el frontend muestra la pantalla
# "Ingresa la clave del equipo". Si se deja vacía (desarrollo local), no se
# exige ninguna clave.
APP_ACCESS_KEY=
# Firma de los ids de sesión que emite el servidor (header X-Session-Id). Si
# falta, se genera una aleatoria por proceso (las sesiones mueren al reiniciar).
SECRET_KEY=
# Tamaño máximo de un archivo subido, en MB (más grande -> 413 antes de leerlo).
MAX_UPLOAD_MB=15
# Máximo de sesiones con proceso de ejecución vivo a la vez (cada una carga
# pandas/matplotlib, ~150-250 MB). Al llenarse, una sesión nueva recibe 503.
MAX_SESSIONS=8
